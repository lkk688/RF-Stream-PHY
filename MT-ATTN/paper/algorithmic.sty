%% Minimal algorithmic.sty -- pseudocode commands for IEEE papers
\ProvidesPackage{algorithmic}[2024/01/01 v0.2 minimal]

%% Boolean keywords
\newcommand{\AND}{\textbf{ and }}
\newcommand{\OR}{\textbf{ or }}
\newcommand{\NOT}{\textbf{not }}
\newcommand{\TRUE}{\textbf{true}}
\newcommand{\FALSE}{\textbf{false}}
\newcommand{\TO}{\textbf{ to }}

%% Algorithmic environment
\newenvironment{algorithmic}[1][0]{%
  \small
  \begin{list}{}{%
    \setlength{\leftmargin}{0pt}%
    \setlength{\itemindent}{0pt}%
    \setlength{\itemsep}{1pt}%
    \setlength{\parsep}{0pt}%
    \setlength{\topsep}{2pt}%
  }%
}{%
  \end{list}%
}

%% Indentation: use \hspace
\newlength{\ALC@level}
\setlength{\ALC@level}{0pt}

%% Statement
\newcommand{\STATE}{\item\hspace*{\ALC@level}}
\newcommand{\REQUIRE}{\item\hspace*{\ALC@level}\textbf{Input: }}
\newcommand{\ENSURE}{\item\hspace*{\ALC@level}\textbf{Output: }}

%% IF block -- manual nesting via hspace adjustments
\newcommand{\IF}[1]{%
  \item\hspace*{\ALC@level}\textbf{if} #1 \textbf{then}%
  \addtolength{\ALC@level}{1.5em}%
}
\newcommand{\ELSIF}[1]{%
  \addtolength{\ALC@level}{-1.5em}%
  \item\hspace*{\ALC@level}\textbf{elsif} #1 \textbf{then}%
  \addtolength{\ALC@level}{1.5em}%
}
\newcommand{\ELSE}{%
  \addtolength{\ALC@level}{-1.5em}%
  \item\hspace*{\ALC@level}\textbf{else}%
  \addtolength{\ALC@level}{1.5em}%
}
\newcommand{\ENDIF}{%
  \addtolength{\ALC@level}{-1.5em}%
  \item\hspace*{\ALC@level}\textbf{end if}%
}

%% WHILE block
\newcommand{\WHILE}[1]{%
  \item\hspace*{\ALC@level}\textbf{while} #1 \textbf{do}%
  \addtolength{\ALC@level}{1.5em}%
}
\newcommand{\ENDWHILE}{%
  \addtolength{\ALC@level}{-1.5em}%
  \item\hspace*{\ALC@level}\textbf{end while}%
}

%% FOR block
\newcommand{\FOR}[1]{%
  \item\hspace*{\ALC@level}\textbf{for} #1 \textbf{do}%
  \addtolength{\ALC@level}{1.5em}%
}
\newcommand{\ENDFOR}{%
  \addtolength{\ALC@level}{-1.5em}%
  \item\hspace*{\ALC@level}\textbf{end for}%
}
